# Kali NetHunter fragment for peridot (SM8635), appended to the verified
# peridot-stock_defconfig by CI. Keep this fragment separate from the stock
# capture: it is the only intentional configuration delta.

# WiFi injection
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8XXXU=m
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7601U=m

# USB gadget (HID attack, serial)
# Keep the gadget core at its stock values. The stock defconfig ships
# USB_CONFIGFS=y / USB_F_HID=y / USB_LIBCOMPOSITE=y. Forcing =m downgrades
# libcomposite to a module, and usb_f_accessory <-> libcomposite then form a
# module dependency cycle: depmod aborts with "Cycle detected".
CONFIG_USB_CONFIGFS=y
CONFIG_USB_F_HID=y
CONFIG_USB_SERIAL=m

# Networking
# TUN is =y in the stock defconfig; keep it built-in rather than downgrading.
CONFIG_TUN=y
CONFIG_NFS_FS=m
