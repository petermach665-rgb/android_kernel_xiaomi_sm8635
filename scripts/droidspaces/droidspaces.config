# Required options for the DroidSpaces flavor. build-flavor.sh validates each
# symbol against this kernel's real Kconfig and forces it to y before olddefconfig.
# NF_CT_NETLINK is the symbol name in this tree; NF_CONNTRACK_NETLINK is not.
SYSVIPC
PID_NS
USER_NS
DEVTMPFS
NF_CT_NETLINK
IP6_NF_NAT
VETH
BRIDGE
OVERLAY_FS
CGROUP_DEVICE
CGROUP_PIDS
