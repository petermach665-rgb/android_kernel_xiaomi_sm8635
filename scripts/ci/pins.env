# Pinned upstreams for every NetHunter flavor. Single source of truth for
# scripts/ci/build-flavor.sh (local builds) and the GitHub workflows.
# Always FULL 40-char SHAs: short SHAs cannot be fetched from GitHub/GitLab
# after a shallow clone and silently fall back to branch tip.

SUSFS_REPO=https://github.com/ShirkNeko/susfs4ksu.git
SUSFS_BRANCH=gki-android14-6.1
SUSFS_PIN=5369359dbd10f6dd8cbdd59d1df7b788b29b168c     # verified gki-android14-6.1 branch tip
SUSFS_EXPECT_VERSION=v2.3.0

KSUN_REPO=https://github.com/KernelSU-Next/KernelSU-Next.git
KSUN_TAG=v3.4.2

SUKISU_REPO=https://github.com/SukiSU-Ultra/SukiSU-Ultra
SUKISU_BRANCH=susfs_new
SUKISU_PIN=278d822a4ebd214bcfd774b7910cb11cdc560bb9
# Kernel-side commits from SukiSU `main` that landed after the susfs_new pin.
# Cherry-picked in this order on top of SUKISU_PIN (verified clean).
SUKISU_MAIN_CHERRYPICKS="baf01faf3e1221405cb258b37f0477023ee596ab e15a797322efe5196661c2bc9d54499ee921006b 6428b35f840271b8a95475b9883c15ce8d74d4aa"

RESUKISU_REPO=https://github.com/ReSukiSU/ReSukiSU
RESUKISU_PIN=3c1882886dbbb54f4aae7ddf205f8ccde32c2a34   # 2026-09-05: selinux status-page/avc-seqno spoof, webview-zygote umount, su selinux ctx, module load filter, susfs sync

KP_VERSION=0.13.8                                        # bmax121/KernelPatch (APatch flavor)
KPTOOLS_SHA256=e0ed71f5db3ace6cc0a0cc10097f2355d3e7fa6d14b3d88e20a20fabe491a39b   # kptools-linux 0.13.8
KPIMG_SHA256=80950685218211a87d993025a88fd1bdedcabfaffaf98949c07c5bb533854e79     # kpimg-android 0.13.8
# No default superkey: it is KernelPatch's only authentication and the APatch app cannot
# change it after the fact, so a published zip with a known key hands root to every app.
# APatch builds require APATCH_SUPERKEY in the environment.

# The archive is pinned to the AOSP prebuilts repository commit that contains
# clang-r563880.  Its AndroidVersion.txt says 21.0.0, based on r563880.  The
# operator brief calls this "r563880c"; that suffix is not the directory or
# release name in the real AOSP repository.
AOSP_CLANG_URL=https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86/+archive/777bc2c71e25056be0f39f6d77a3c8d1cd6a839e/clang-r563880.tar.gz
AOSP_CLANG_ID="Android (14054515"
AOSP_CLANG_REV=r563880
